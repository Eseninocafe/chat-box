{
	"settings": [
		{
			"id": "receipt",
			"label": "Receipt",
			"description": "Encases chat box in a receipt",
			"type": "checkbox",
			"defaultValue": false,
			"omitWhenDefault": true,
			"group": ""
		},
		{
			"id": "stingers",
			"label": "Enable Stingers",
			"description": "Chat will fade out for stinger",
			"type": "checkbox",
			"defaultValue": false,
			"omitWhenDefault": true,
			"hideWhen": "receipt",
			"group": ""
		},
		{
			"id": "showPlatform",
			"label": "Show Platform",
			"type": "checkbox",
			"defaultValue": true,
			"group": "Show in messages"
		},
		{
			"id": "showAvatar",
			"label": "Show Avatar",
			"type": "checkbox",
			"defaultValue": true,
			"group": "Show in messages"
		},
		{
			"id": "showTimestamps",
			"label": "Show Timestamps",
			"type": "checkbox",
			"defaultValue": true,
			"group": "Show in messages"
		},
		{
			"id": "showBadges",
			"label": "Show Badges",
			"type": "checkbox",
			"defaultValue": true,
			"group": "Show in messages"
		},
		{
			"id": "showUsername",
			"label": "Show Username",
			"type": "checkbox",
			"defaultValue": true,
			"group": "Show in messages"
		},
		{
			"id": "ignoreChatters",
			"type": "text",
			"placeholder": "Usernames, comma separated",
