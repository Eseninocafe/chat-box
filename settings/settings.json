				{ "value": 40, "label": "Broadcaster" },
				{ "value": 30, "label": "Mods & Broadcaster" },
				{ "value": 20, "label": "VIPs, Mods & Broadcaster" },
				{ "value": 15, "label": "Subs, VIPs, Mods & Broadcaster" },
				{ "value": 10, "label": "Everyone" },
				{ "value": 69420, "label": "Nobody" }
			],
			"defaultValue": 20,
			"group": "Embed images from"
		},
		{
			"id": "showTwitchMessages",
			"label": "Chat Messages",
			"type": "checkbox",
			"defaultValue": true,
